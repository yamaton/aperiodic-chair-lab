  exact (Fin.cases pair_checked_0 (Fin.cases pair_checked_1 (Fin.cases pair_checked_2 (Fin.cases pair_checked_3 (Fin.cases pair_checked_4 (Fin.cases pair_checked_5 (Fin.cases pair_checked_6 (Fin.cases pair_checked_7 (Fin.cases pair_checked_8 (Fin.cases pair_checked_9 (Fin.cases pair_checked_10 (Fin.cases pair_checked_11 (Fin.cases pair_checked_12 (Fin.cases pair_checked_13 (Fin.cases pair_checked_14 (Fin.cases pair_checked_15 (Fin.cases pair_checked_16 (Fin.cases pair_checked_17 (Fin.cases pair_checked_18 (Fin.cases pair_checked_19 (Fin.cases pair_checked_20 (Fin.cases pair_checked_21 (Fin.cases pair_checked_22 (Fin.cases pair_checked_23 (Fin.cases pair_checked_24 (Fin.cases pair_checked_25 (Fin.cases pair_checked_26 (Fin.cases pair_checked_27 (Fin.cases pair_checked_28 (Fin.cases pair_checked_29 (Fin.cases pair_checked_30 (Fin.cases pair_checked_31 (Fin.cases pair_checked_32 (Fin.cases pair_checked_33 (Fin.cases pair_checked_34 (Fin.cases pair_checked_35 (Fin.cases pair_checked_36 (Fin.cases pair_checked_37 (Fin.cases pair_checked_38 (Fin.cases pair_checked_39 (Fin.cases pair_checked_40 (Fin.cases pair_checked_41 (Fin.cases pair_checked_42 (Fin.cases pair_checked_43 (fun i => Fin.elim0 i)))))))))))))))))))))))))))))))))))))))))))))

theorem incompatible_checked (i j : ContactId) (h : incompatible i j = true) :
    ∃ w, rejectCheck (placed (contactMotion i)) (placed (contactMotion j)) zero w = true := by
  have checked := pair_checked i j
  unfold incompatible at h
  cases hw : pairWitness i j with
  | none => simp [hw] at h
  | some w => exact ⟨w, by simpa [hw] using checked⟩

theorem incompatible_self (i : ContactId) : incompatible i i = false := by
  revert i
  decide +kernel

private theorem accepted_checked : ∀ r : Fin 24,
    (fineAccepted r).all (fun t => (List.finRange 44).any (fun i =>
      decide ((contactMotion i).shift = t ∧ (contactMotion i).frame.mat = rotation r))) = true := by
  decide +kernel

theorem accepted_motion (r : Fin 24) (t : V3) (ht : t ∈ fineAccepted r) :
    ∃ i : ContactId, (contactMotion i).shift = t ∧
      (contactMotion i).frame.mat = rotation r := by
  have h := (List.all_eq_true.mp (accepted_checked r)) t ht
  obtain ⟨i, _, hi⟩ := List.any_eq_true.mp h
  exact ⟨i, of_decide_eq_true hi⟩

