def group : List GridMotion := GridMotion.identity :: outer.map contactMotion

theorem contactMotion_injective : ∀ i j : ContactId, contactMotion i = contactMotion j → i = j := by
  decide +kernel

theorem outer_inverse_notch : ∀ i ∈ outer,
    ∃ j ∈ notch, (contactMotion i).inv = contactMotion j := by
  decide +kernel

theorem ordinary_notch_inverse_trigger : ∀ i ∈ notch, i ≠ 37 →
    ∃ j ∈ triggers, (contactMotion i).inv = contactMotion j := by
  decide +kernel

theorem exceptional_relative :
    (contactMotion 37).inv.comp (contactMotion 39) = contactMotion 28 := by
  decide +kernel

theorem exceptional_sibling :
    (contactMotion 4).inv.comp (contactMotion 28) = contactMotion 39 := by
  decide +kernel

theorem same_notch_inverse : (contactMotion 37).inv = contactMotion 4 := by decide +kernel

